# ============================================
# Repo Autopsy — Environment Variables Template
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local (which is in .gitignore)
#    Command: cp .env.example .env.local
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit .env.local to git
#
# ============================================

# GitHub personal access token (optional but strongly recommended to avoid rate limits)
# Required scope: public_repo (for public repos) or repo (for private repos)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit (no real secrets)
# - Your actual .env.local file is in .gitignore
# - Never hardcode credentials in source code
# - Access values in code via process.env.GITHUB_TOKEN
# ============================================
